{
  "name": "react16-ssr-template",
  "version": "1.0.0",
  "description": "Template for react 16 ssr app",
  "repository": "https://github.com/dvo4253/react16-ssr.git",
  "scripts": {
    "predev": "rm -rf ./dist",
    "dev": "npm run lint && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:analyze": "BUNDLE_ANALYZER=true npm run dev",
    "dev:server": "NODE_ENV=development BABEL_ENV=development nodemon src/server/index.js --exec babel-node",
    "dev:client": "NODE_ENV=development BABEL_ENV=development webpack-dev-server --config webpack/webpack.dev.babel.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "webpack --config webpack/webpack.prod.babel.js",
    "build:server": "webpack --config webpack/webpack.server.babel.js",
    "start": "node ./dist/server/index.js",
    "test": "npm run lint && jest --watch",
    "test:ci": "npm run lint && jest --coverage",
    "lint": "eslint --fix ./",
    "init": "source init.sh",
    "clean": "rm -rf node_modules && rm -rf dist",
    "clean:install": "npm run clean && npm install && npm outdated"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/core": "7.10.4",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "assets-webpack-plugin": "7.1.1",
    "autoprefixer": "10.5.5",
    "axios": "0.19.2",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.1.0",
    "babel-loader": "10.1.1",
    "enzyme": "3.11.0",
    "concurrently": "10.0.5",
    "enzyme-adapter-react-16": "1.15.8",
    "eslint": "10.10.0",
    "express": "4.17.1",
    "express-winston": "4.2.0",
    "html-webpack-harddisk-plugin": "2.0.0",
    "html-webpack-plugin": "5.6.8",
    "html-webpack-pug-plugin": "4.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "node-sass": "4.14.1",
    "optimize-css-assets-webpack-plugin": "6.0.1",
    "postcss-loader": "8.2.1",
    "prop-types": "15.8.1",
    "pug": "3.0.0",
    "ramda": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redux": "5.0.1",
    "sass-loader": "17.0.1",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.110.3",
    "webpack-disk-plugin": "0.0.2",
    "webpack-merge": "6.0.1",
    "webpack-node-externals": "3.0.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@babel/node": "8.0.1",
    "css-loader": "7.1.5",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.5.1",
    "nodemon": "3.1.14",
    "style-loader": "4.0.0",
    "supertest": "7.2.2",
    "wait-on": "9.1.0",
    "webpack-bundle-analyzer": "5.3.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "3.11.0"
  }
}
